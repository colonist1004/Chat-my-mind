# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  cp .env.example .env
# .env 는 git 에 올라가지 않습니다. (API 키가 들어 있으므로 절대 공유하지 마세요)

# Claude API 키 (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=

# 접속 주소. 도메인이 없으면 서버 공인 IP 의 점(.)을 대시(-)로 바꿔 sslip.io 를 붙이면 됩니다.
# 예) 공인 IP 가 152.67.10.20 이면 → DOMAIN=152-67-10-20.sslip.io
DOMAIN=

# 가입할 때 필요한 초대 코드. 비워 두면 누구나 가입할 수 있어 API 비용이 나갈 수 있습니다.
INVITE_CODE=

# 가입 자체를 막으려면 false (이미 만든 계정은 계속 로그인 가능)
ALLOW_SIGNUP=true

# 사용자 1명당 하루 AI 답변 횟수 (0 = 무제한). 첫 가입자(관리자)는 항상 무제한.
DAILY_MESSAGE_LIMIT=100

# 기본 모델과 사용자에게 허용할 모델 (쉼표로 구분)
DEFAULT_MODEL=claude-opus-5-5
ALLOWED_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
